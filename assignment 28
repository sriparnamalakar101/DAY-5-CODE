#include <stdio.h>

int main() {
    float basic, hra, ta, da, gross;
    int choice;

    // Input basic salary
    printf("Enter basic salary of the employee: ");
    scanf("%f", &basic);

    // Menu for user
    printf("\nChoose what you want to calculate:\n");
    printf("1. HRA (20%% of Basic Salary)\n");
    printf("2. TA  (10%% of Basic Salary)\n");
    printf("3. DA  (5%% of Basic Salary)\n");
    printf("4. Gross Salary\n");
    printf("Enter your choice (1-4): ");
    scanf("%d", &choice);

    // Switch case
    switch (choice) {
        case 1:
            hra = 0.20 * basic;
            printf("HRA = %.2f\n", hra);
            break;

        case 2:
            ta = 0.10 * basic;
            printf("TA = %.2f\n", ta);
            break;

        case 3:
            da = 0.05 * basic;
            printf("DA = %.2f\n", da);
            break;

        case 4:
            hra = 0.20 * basic;
            ta = 0.10 * basic;
            da = 0.05 * basic;
            gross = basic + hra + ta + da;
            printf("Gross Salary = %.2f\n", gross);
            break;

        default:
            printf("Invalid choice! Please enter a valid option (1-4).\n");
    }

    return 0;
}
